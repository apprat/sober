{
  "name": "sober",
  "version": "2.0.0-alpha.13",
  "description": "Sober is a library of UI components designed with reference to Material You.",
  "type": "module",
  "scripts": {
    "dev": "node dev/dev-server.js",
    "preview": "node dev/dev-preview.js",
    "build": "node dev/build.js",
    "check": "npx tsc --noEmit",
    "test": "node dev/test.js",
    "update": "pnpm update",
    "publish:alpha": "npm publish --tag alpha"
  },
  "keywords": [
    "sober",
    "material you",
    "material design",
    "web components",
    "web",
    "ui",
    "ui library",
    "vue",
    "react",
    "angular"
  ],
  "exports": {
    ".": "./dist/main.js",
    "./theme": "./dist/theme.js",
    "./styles/*": "./styles/*",
    "./*": "./dist/components/*.js"
  },
  "author": "apprat",
  "repository": "unreal-space/sober",
  "homepage": "https://soberjs.com",
  "license": "MIT",
  "main": "./dist/main.js",
  "devDependencies": {
    "cssnano": "^8.0.2",
    "esbuild": "^0.28.1",
    "html-minifier": "^4.0.0",
    "markdown-it": "^14.2.0",
    "postcss": "^8.5.15",
    "postcss-nested": "^7.0.2",
    "shiki": "^4.2.0",
    "typescript": "^6.0.3",
    "@shikijs/transformers": "^4.2.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0"
  },
  "funding": [
    "https://mangotool.cn",
    "https://www.bplewiki.top",
    "https://www.qiaoxh.com",
    "https://uoice.com"
  ]
